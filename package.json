{
  "name": "liquid-js-sdk",
  "version": "0.0.4-beta",
  "description": "A universal (browser + Node.js) SDK for all Liquid authentication platform APIs.",
  "keywords": [
    "liquid",
    "auth",
    "oauth",
    "sdk",
    "api-client"
  ],
  "author": "Shrihari Prakasam <shrihariprakash@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrihari-prakash/liquid-js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/shrihari-prakash/liquid-js-sdk/issues"
  },
  "homepage": "https://github.com/shrihari-prakash/liquid-js-sdk#readme",
  "engines": {
    "node": ">= 18.x"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
